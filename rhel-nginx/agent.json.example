{
  "config_version": 3,
  "api_base": "https://certm.pmr.vn/api/v2",
  "display_name": "",
  "enrollment_token": "PUT_ENROLLMENT_KEY_HERE",
  "machine_id_file": "/etc/machine-id",
  "service": {
    "type": "nginx",
    "systemd_unit": "nginx"
  },
  "paths": {
    "backup_root": "/opt/certm-agent/bkup",
    "managed_certificate_root": "/etc/certm/live",
    "log_file": "/var/log/certm/certm-agent.log",
    "lock_file": "/run/certm-agent.lock",
    "state_root": "/var/lib/certm/bindings"
  },
  "network": {
    "api_timeout_seconds": 30
  },
  "verify": {
    "connect_host": "",
    "connect_timeout_seconds": 15,
    "retry_timeout_seconds": 30,
    "retry_interval_seconds": 1
  },
  "discovery": {
    "max_bindings": 1000,
    "allowed_config_roots": [
      "/etc/nginx"
    ],
    "allowed_certificate_roots": [
      "/etc/certm",
      "/etc/nginx",
      "/etc/pki/tls",
      "/etc/letsencrypt",
      "/opt/certm-agent/live"
    ]
  }
}
