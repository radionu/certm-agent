#!/bin/sh

set -eu

AGENT_DIR='/conf/certm'
AGENT_PATH="${AGENT_DIR}/CertM.HAProxy.Agent.php"
LOG_PATH='/var/log/certm-haproxy.log'
PHP_BIN='/usr/local/bin/php'
FETCH_BIN='/usr/bin/fetch'
INSTALL_URL='https://raw.githubusercontent.com/radionu/certm-agent/main/pfsense/install.sh'

if [ ! -f "${AGENT_PATH}" ]; then
    echo "FAILED: CertM agent is missing: ${AGENT_PATH}" >&2
    exit 1
fi

command_name=${1:-status}

case "${command_name}" in
    status|preflight|enroll|inventory|dry-run|renew|run)
        exec "${PHP_BIN}" -f "${AGENT_PATH}" "${command_name}"
        ;;
    enable)
        exec "${PHP_BIN}" -f "${AGENT_PATH}" install-cron
        ;;
    disable)
        exec "${PHP_BIN}" -f "${AGENT_PATH}" remove-cron
        ;;
    logs)
        lines=${2:-50}
        case "${lines}" in
            ''|*[!0-9]*)
                echo 'FAILED: Log line count must be a positive integer.' >&2
                exit 1
                ;;
        esac
        if [ ! -f "${LOG_PATH}" ]; then
            echo "No log exists yet at ${LOG_PATH}."
            exit 0
        fi
        exec tail -n "${lines}" "${LOG_PATH}"
        ;;
    update)
        if [ "$(id -u)" -ne 0 ]; then
            echo 'FAILED: Run update as root on pfSense.' >&2
            exit 1
        fi
        temporary="/tmp/install-certm-pfsense.$$"
        trap 'rm -f "${temporary}"' EXIT HUP INT TERM
        "${FETCH_BIN}" -qo "${temporary}" "${INSTALL_URL}"
        /bin/sh -n "${temporary}"
        /bin/sh "${temporary}"
        ;;
    help|-h|--help)
        echo 'Usage: certm-haproxy status|preflight|enroll|inventory|dry-run|renew|run|enable|disable|logs [lines]|update'
        ;;
    *)
        echo "FAILED: Unknown command: ${command_name}" >&2
        echo 'Usage: certm-haproxy status|preflight|enroll|inventory|dry-run|renew|run|enable|disable|logs [lines]|update' >&2
        exit 1
        ;;
esac
